# Copy this file to .env and fill in what you have.
# .env is private: it is ignored by git and never uploaded to GitHub.

# ---- Keys ---------------------------------------------------------------
# Google AI Studio (free tier): https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# Anthropic API (optional, billed per token): https://platform.claude.com
# A Claude Pro/Max subscription is NOT an API key. Leave empty if you only
# have a subscription - the Claude Code lessons use your subscription instead.
ANTHROPIC_API_KEY=

# ---- Which model the Python lessons use ---------------------------------
# auto   = Claude if ANTHROPIC_API_KEY is set, else Gemini, else offline mock
# claude | gemini | mock (mock = free fake model for practice)
LLM_PROVIDER=auto

CLAUDE_MODEL=claude-opus-5-5
# Model used by sub-agents. To spend less you may choose claude-sonnet-5-5
# or claude-haiku-5-5 here.
CLAUDE_WORKER_MODEL=claude-opus-5-5

# "gemini-flash-latest" always points at Google's newest Flash model.
GEMINI_MODEL=gemini-flash-latest
GEMINI_WORKER_MODEL=gemini-flash-latest

# ---- Where you are (weather & holiday tools) ------------------------------
HOME_CITY=London
HOME_COUNTRY_CODE=GB

# ---- Final project: your personal assistant ------------------------------
ASSISTANT_OWNER_NAME=
ASSISTANT_DAILY_BUDGET_USD=1.00
BRIEFING_TIME=07:00
# Telegram (milestone 5): token from @BotFather; your id from the bot's /start reply
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_ID=
# Real calendar (milestone 6): your calendar's secret iCal/ICS link (keep it private)
CALENDAR_ICS_URL=
# Real email (milestone 6): read-only IMAP, e.g. imap.gmail.com + an app password
EMAIL_IMAP_HOST=
EMAIL_ADDRESS=
EMAIL_APP_PASSWORD=

# ---- Safety limits (the Governor) ---------------------------------------
MAX_USD_PER_RUN=1.00
MAX_AGENTS_PER_RUN=6
MAX_SPAWN_DEPTH=2
WEB_ALLOWLIST=en.wikipedia.org,docs.python.org,ai.google.dev,docs.claude.com,code.claude.com
